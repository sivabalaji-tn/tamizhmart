# ============================================================
# TamizhMart — Apache .htaccess
# Place this in /tamizhmart/ (your project root)
# ============================================================

Options -Indexes
Options -MultiViews
ServerSignature Off

# ── Rewrite Engine ───────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /tamizhmart/

    # Force HTTP → HTTPS (Task 1)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remove trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Protect sensitive files
    RewriteRule ^config/.*$    - [F,L]
    RewriteRule ^\.env$        - [F,L]
    RewriteRule ^.*\.sql$      - [F,L]
    RewriteRule ^.*\.log$      - [F,L]
    RewriteRule ^.*\.sh$       - [F,L]
    RewriteRule ^composer\..*$ - [F,L]

    # Serve sw.js from root with correct scope
    RewriteRule ^sw\.js$ sw.js [L]

    # ── Clean Shop URLs ──────────────────────────────────────
    # Before:  /shop/index.php?shop=sm-store-1772034769
    # After:   /sm-store   OR   /shop/sm-store
    #
    # Option A: /slug  →  shop/index.php?shop=slug  (root access)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(owner|superadmin|auth|assets|uploads|config|shop/index\.php)
    RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ shop/index.php?shop=$1 [L,QSA]
    #
    # Option B: /shop/slug  →  shop/index.php?shop=slug
    RewriteRule ^shop/([a-z0-9][a-z0-9-]*)/?$ shop/index.php?shop=$1 [L,QSA]

    # 404 handler
    ErrorDocument 404 /tamizhmart/404.php
    ErrorDocument 403 /tamizhmart/404.php
</IfModule>

# ── Security Headers ─────────────────────────────────────────
<IfModule mod_headers.c>

    # Task 1+2: HSTS — force HTTPS for 1 year, include subdomains
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Existing hardening
    Header always set X-Content-Type-Options    "nosniff"
    Header always set X-Frame-Options           "SAMEORIGIN"
    Header always set X-XSS-Protection          "1; mode=block"
    Header always set Referrer-Policy           "strict-origin-when-cross-origin"
    Header always set Permissions-Policy        "geolocation=(), microphone=(), camera=(), payment=()"

    # Task 3: Content Security Policy
    # Allows: self, Google Fonts, Bootstrap CDN, Razorpay, Chart.js, SortableJS
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'     https://checkout.razorpay.com     https://cdn.jsdelivr.net     https://cdnjs.cloudflare.com     https://www.gstatic.com; style-src 'self' 'unsafe-inline'     https://fonts.googleapis.com     https://cdn.jsdelivr.net     https://cdnjs.cloudflare.com; font-src 'self'     https://fonts.gstatic.com     https://cdn.jsdelivr.net; img-src 'self' data: blob:     https://razorpay.com     https://www.gstatic.com; connect-src 'self'     https://api.razorpay.com     https://checkout.razorpay.com; frame-src     https://api.razorpay.com     https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self';"

    # Task 8: COOP / COEP / CORP headers
    Header always set Cross-Origin-Opener-Policy    "same-origin-allow-popups"
    Header always set Cross-Origin-Embedder-Policy  "unsafe-none"
    Header always set Cross-Origin-Resource-Policy  "same-site"

    # Task 5+6: Hide server info (also needs php.ini — see config/db.php note below)
    Header always unset X-Powered-By
    Header always unset Server

    # Service Worker headers
    <FilesMatch "sw\.js$">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Manifest headers
    <FilesMatch "manifest\.php$">
        Header set Content-Type "application/manifest+json"
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

</IfModule>

# ── Browser Caching ──────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Images — 1 month
    ExpiresByType image/jpeg        "access plus 1 month"
    ExpiresByType image/png         "access plus 1 month"
    ExpiresByType image/webp        "access plus 1 month"
    ExpiresByType image/gif         "access plus 1 month"
    ExpiresByType image/svg+xml     "access plus 1 month"
    ExpiresByType image/x-icon      "access plus 1 year"

    # CSS / JS — 1 week
    ExpiresByType text/css          "access plus 1 week"
    ExpiresByType text/javascript   "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"

    # Fonts — 1 year
    ExpiresByType font/woff2        "access plus 1 year"
    ExpiresByType font/woff         "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # HTML / PHP — no cache
    ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Upload size limit ────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value memory_limit 256M
</IfModule>

# ── Block bad bots & scrapers ────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (ahrefs|semrush|dotbot|MJ12bot) [NC]
    RewriteRule .* - [F,L]
</IfModule>
